pipeline {
    agent any

    stages {

        stage('Welcome') {
            steps {
                echo 'Welcome to Jenkins!'
            }
        }

        stage('Install') {
            steps {
                echo 'Installing application'
            }
        }

        stage('Build') {
            steps {
                echo 'Building application'
            }
        }

        stage('Test') {
            steps {
                echo 'Application testing'
            }
        }
    }
}